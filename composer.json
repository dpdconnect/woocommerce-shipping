{
  "name": "dpdconnect/woocommerce-shipping",
  "description": "DPD WooCommerce shipping extension",
  "license": "GPL-3.0-or-later",
  "autoload": {
    "psr-4": {
      "DpdConnect\\classes\\": ["classes"]

    }
  },
  "require": {
    "php": ">=8.1",
    "dpdconnect/php-sdk": "^2.1",
    "myokyawhtun/pdfmerger": "dev-master"
  },
  "config": {
    "platform": {
      "php": "8.1.0"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.13.6",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  }
}
